# Staging environment secrets — template.
# Copy to .env.staging (gitignored), fill in real values, then run:
#   scripts/set-env-secrets.sh staging
# Values are pushed to the GitHub `staging` Environment and (via
# scripts/sync-secrets.sh) to the staging Cloudflare account. NEVER commit
# the filled file (SEC-002/SEC-004).

# Cloudflare staging account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Neon staging database (pooled connection string)
DATABASE_URL=

# App secrets (staging values — Stripe TEST keys)
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Optional: optimizer worker LLM key
LLM_API_KEY=

# No frontend API URL is configured: classprints-web proxies /api/* to
# classprints-api through a service binding so auth cookies stay first-party.

