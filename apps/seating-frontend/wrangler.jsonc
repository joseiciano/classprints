{
  // ClassPrints frontend — Workers static assets serving the Vite build (TASK-003,
  // ALT-007 preferred option). Top-level = staging, env.production = production.
  // The API is reached same-origin: /api/* is forwarded to classprints-api via a
  // service binding below, so auth cookies are first-party and sessions survive
  // a page refresh. No build-time API URL is baked into the bundle.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classprints-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "API",
      "service": "classprints-api",
    },
  ],
  "env": {
    "production": {
      "name": "classprints-web",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "classprints.app",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "API",
          "service": "classprints-api",
        }
      ]
    }
  }
}
