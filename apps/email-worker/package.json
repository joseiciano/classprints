    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "~5.9.3",
    "vitest": "4.0.14",
    "wrangler": "4.57.0"
  }
}
