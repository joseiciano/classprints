{
  "name": "@classprints/email-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy src/index.ts --name classprints-email --compatibility-date 2026-09-14 --dry-run --outdir dist",
