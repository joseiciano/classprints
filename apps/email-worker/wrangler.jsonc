{
  // ClassPrints email worker — consumes completed email jobs and sends result emails.
  // Top-level = staging (default), env.production = production overrides.
  // Sends through Cloudflare Email Service (send_email binding); no secrets needed.
  // Sender varies by env: ClassPrints (staging), Bellvel (production).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classprints-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "EMAIL_FROM_ADDRESS": "noreply@staging.myclassprints.com",
    "EMAIL_FROM_NAME": "ClassPrints"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@staging.myclassprints.com"]
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00c42d1a16da45f0a7e9d9ef1d2aa99c"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "email-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "classprints_email_staging"
    }
  ],
  "env": {
    "production": {
      "name": "classprints-email",
      "workers_dev": false,
      "vars": {
        "EMAIL_FROM_ADDRESS": "noreply@bellvel.com",
        "EMAIL_FROM_NAME": "Bellvel"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@bellvel.com"]
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<PRODUCTION_HYPERDRIVE_ID>"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "email-jobs",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3
          }
        ]
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "classprints_email_production"
        }
      ]
    }
  }
}
