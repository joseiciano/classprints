{
  // ClassPrints API worker — top-level = staging (default deploy target, REQ-007),
  // env.production = production overrides (REQ-008).
  // User-facing display name varies by env: ClassPrints (staging), Bellvel (production).
  // Secrets (BETTER_AUTH_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) are set
  // per account via `wrangler secret put <KEY>` (SEC-002); wrangler 4.57 has no
  // `secrets.required` config key, so required secret names are tracked here only.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classprints-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  // Staging (default) — replace <...> placeholders with real values after
  // bootstrap (scripts/bootstrap.sh prints the IDs).
  "vars": {
    "ENVIRONMENT": "staging",
    "APPLICATION_NAME": "seating-backend",
    "FRONTEND_URL": "https://classprints-web.icianojn.workers.dev",
    "ALLOWED_ORIGINS": "https://classprints-web.icianojn.workers.dev",
    "STRIPE_PRICE_PLUS_MONTHLY": "price_1UT4A8Ru9HudY5jD8oi4JTlc",
    "STRIPE_PRICE_PLUS_QUARTERLY": "price_1UT4A8Ru9HudY5jDAdklj0AU",
    "STRIPE_PRICE_PLUS_ANNUAL": "price_1UT4A9Ru9HudY5jDib67O0wM",
    "STRIPE_CHECKOUT_SUCCESS_URL": "https://classprints-web.icianojn.workers.dev/billing/success",
    "STRIPE_CHECKOUT_CANCEL_URL": "https://classprints-web.icianojn.workers.dev/pricing",
    "STRIPE_PORTAL_RETURN_URL": "https://classprints-web.icianojn.workers.dev/settings",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UT4AARu9HudY5jDjjxr8LXo",
    "EMAIL_FROM_ADDRESS": "noreply@staging.myclassprints.com",
    "EMAIL_FROM_NAME": "ClassPrints",
    "APP_DISPLAY_NAME": "ClassPrints",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@staging.myclassprints.com"],
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00c42d1a16da45f0a7e9d9ef1d2aa99c",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SEATING_JOBS",
        "queue": "seating-jobs",
      },
      {
        "binding": "TRANSCRIPTION_JOBS",
        "queue": "transcription-jobs",
      },
      {
        "binding": "DOCUMENT_CLEANUP_JOBS",
        "queue": "document-cleanup-jobs",
      },
    ],
  },
  "images": {
    "binding": "IMAGES",
  },
  "r2_buckets": [
    {
      "binding": "ASSIGNMENT_IMAGES",
      "bucket_name": "assignment-reader-staging",
    },
  ],
  "ratelimits": [
    {
      "name": "API_RATELIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "classprints_api_staging",
    },
  ],
  "env": {
    "production": {
      "name": "classprints-api",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.bellvel.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APPLICATION_NAME": "seating-backend",
        "FRONTEND_URL": "https://bellvel.com",
        "ALLOWED_ORIGINS": "https://bellvel.com",
        "STRIPE_PRICE_PLUS_MONTHLY": "price_1USi5LRqUpXfgjegzH9Em1BE",
        "STRIPE_PRICE_PLUS_QUARTERLY": "price_1USi5LRqUpXfgjeg9srOqyf1",
        "STRIPE_PRICE_PLUS_ANNUAL": "price_1USi5MRqUpXfgjeg9uIHZLHI",
        "STRIPE_CHECKOUT_SUCCESS_URL": "https://bellvel.com/billing/success",
        "STRIPE_CHECKOUT_CANCEL_URL": "https://bellvel.com/pricing",
        "STRIPE_PORTAL_RETURN_URL": "https://bellvel.com/settings",
        "STRIPE_PORTAL_CONFIGURATION_ID": "",
        "EMAIL_FROM_ADDRESS": "noreply@bellvel.com",
        "EMAIL_FROM_NAME": "Bellvel",
        "APP_DISPLAY_NAME": "Bellvel",
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@bellvel.com"],
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "939494edf57943408759e32fb888ff27",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "SEATING_JOBS",
            "queue": "seating-jobs",
          },
          {
            "binding": "TRANSCRIPTION_JOBS",
            "queue": "transcription-jobs",
          },
          {
            "binding": "DOCUMENT_CLEANUP_JOBS",
            "queue": "document-cleanup-jobs",
          },
        ],
      },
      "images": {
        "binding": "IMAGES",
      },
      "r2_buckets": [
        {
          "binding": "ASSIGNMENT_IMAGES",
          "bucket_name": "assignment-reader-production",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RATELIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60,
          },
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "classprints_api_production",
        },
      ],
    },
  },
}
