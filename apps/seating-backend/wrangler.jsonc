{
  // ClassPrints API worker — top-level = staging (default deploy target, REQ-007),
  // env.production = production overrides (REQ-008).
  // Secrets (BETTER_AUTH_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) are set
  // per account via `wrangler secret put <KEY>` (SEC-002); wrangler 4.57 has no
  // `secrets.required` config key, so required secret names are tracked here only.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classprints-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  // Staging (default) — replace <...> placeholders with real values after bootstrap
  // (scripts/bootstrap.sh prints the IDs; see plan TASK-006).
  "vars": {
    "ENVIRONMENT": "staging",
    "APPLICATION_NAME": "seating-backend",
    "FRONTEND_URL": "https://classprints-web.icianojn.workers.dev",
    "ALLOWED_ORIGINS": "https://classprints-web.icianojn.workers.dev",
    "STRIPE_PRICE_PLUS_MONTHLY": "",
    "STRIPE_PRICE_PLUS_QUARTERLY": "",
    "STRIPE_PRICE_PLUS_ANNUAL": "",
    "STRIPE_CHECKOUT_SUCCESS_URL": "https://classprints-web.icianojn.workers.dev/billing/success",
    "STRIPE_CHECKOUT_CANCEL_URL": "https://classprints-web.icianojn.workers.dev/billing/cancel",
    "STRIPE_PORTAL_RETURN_URL": "https://classprints-web.icianojn.workers.dev/billing/portal-return",
    "EMAIL_FROM_ADDRESS": "noreply@staging.myclassprints.com",
    "EMAIL_FROM_NAME": "ClassPrints",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@staging.myclassprints.com"],
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00c42d1a16da45f0a7e9d9ef1d2aa99c",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SEATING_JOBS",
        "queue": "seating-jobs",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "API_RATELIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "classprints_api_staging",
    },
  ],
  "env": {
    "production": {
      "name": "classprints-api",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "APPLICATION_NAME": "seating-backend",
        "FRONTEND_URL": "https://classprints.app",
        "ALLOWED_ORIGINS": "https://classprints.app",
        "STRIPE_PRICE_PLUS_MONTHLY": "<STRIPE_PRICE_PLUS_MONTHLY_PRODUCTION>",
        "STRIPE_PRICE_PLUS_QUARTERLY": "<STRIPE_PRICE_PLUS_QUARTERLY_PRODUCTION>",
        "STRIPE_PRICE_PLUS_ANNUAL": "<STRIPE_PRICE_PLUS_ANNUAL_PRODUCTION>",
        "STRIPE_CHECKOUT_SUCCESS_URL": "https://classprints.app/billing/success",
        "STRIPE_CHECKOUT_CANCEL_URL": "https://classprints.app/billing/cancel",
        "STRIPE_PORTAL_RETURN_URL": "https://classprints.app/billing/portal-return",
        "EMAIL_FROM_ADDRESS": "noreply@classprints.app",
        "EMAIL_FROM_NAME": "ClassPrints",
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@classprints.app"],
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "<PRODUCTION_HYPERDRIVE_ID>",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "SEATING_JOBS",
            "queue": "seating-jobs",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "API_RATELIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60,
          },
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "classprints_api_production",
        },
      ],
    },
  },
}
