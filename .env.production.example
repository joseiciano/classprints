# Production environment secrets — template.
# Copy to .env.production (gitignored), fill in real values, then run:
#   scripts/set-env-secrets.sh production
# Values are pushed to the GitHub `production` Environment and (via
# scripts/sync-secrets.sh) to the production Cloudflare account. NEVER commit
# the filled file (SEC-002/SEC-004).

# Cloudflare production account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Neon production database (pooled connection string)
DATABASE_URL=

# App secrets (production values — Stripe LIVE keys)
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Optional: optimizer worker LLM key
LLM_API_KEY=

# Build-time frontend API origin (GitHub Environment VARIABLE, not a secret).
# Uses the API Worker's default production workers.dev route.
VITE_SEATING_API_URL=https://classprints-api.chipperroach.workers.dev
